# --- OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# --- Secrets & local env (examples are committed)
.env
.env.*
!.env.example

# --- Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
htmlcov/

# --- Backend data: local DB and dataset files are never committed
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/raw/*
!backend/data/raw/.gitkeep

# --- Node / Next.js (frontend/.gitignore has the rest)
node_modules/
.next/
backend/data/e2e.db*
