# Copy to backend/.env and adjust. All values are optional; defaults shown.

# Environment label surfaced in /api/health (development | test | production).
APP_ENV=development

# SQLAlchemy URL. Relative SQLite paths resolve against the backend/ directory.
DATABASE_URL=sqlite:///./data/sevaro_pulse.db

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional simulation reference time. ISO-8601 WITH a UTC offset, e.g.
# 2026-01-01T12:00:00-05:00. Used when an imported dataset has no manifest and no
# reference time is given on import. Leave empty to derive it from the dataset.
SIMULATION_REFERENCE_TIME=

# Where dataset CSV files / ZIP archives may be placed.
DATASET_DIR=./data/raw

# The bundled SYNTHETIC SAMPLE DATA loaded by POST /api/datasets/sample.
SAMPLE_DATASET_DIR=./sample_data/synthetic_dev

# Optional JSON file that overrides CSV column aliases and value vocabularies
# (see docs/dataset-import-plan.md). Leave empty to use the built-in mapping.
DATASET_MAPPING_FILE=

# Optional JSON file that overrides alert thresholds, severities and coverage policies
# (see docs/risk-and-coverage.md). Leave empty to use the built-in rules.
RISK_RULES_FILE=

# Optional JSON file that overrides Phase 4 optimizer policy: routing weights, split-shift
# limits, trap protection, solver time limits (see docs/optimization.md).
OPTIMIZATION_POLICY_FILE=

# Upload safety limits (bytes / entries).
MAX_UPLOAD_BYTES=52428800
MAX_UNCOMPRESSED_BYTES=209715200
MAX_ARCHIVE_ENTRIES=200
