# Docker Compose settings. Copy to .env next to docker-compose.yml. All values are optional.
# (On AWS, deploy/aws/deploy.sh writes this file on the server for you.)

# Where Caddy serves the app. ":80" = plain HTTP on any host name or IP. A domain name such as
# pulse.example.com turns on automatic HTTPS (its DNS must point at the server).
SITE_ADDRESS=:80

# Host ports published by Caddy. Change these locally if 80/443 are taken.
HTTP_PORT=80
HTTPS_PORT=443

# Image names: <IMAGE_PREFIX>/backend:<IMAGE_TAG> and <IMAGE_PREFIX>/frontend:<IMAGE_TAG>.
# On AWS the prefix is the ECR registry, e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com/sevaro-pulse
IMAGE_PREFIX=sevaro-pulse
IMAGE_TAG=latest

# Backend (see README "Configuration").
APP_ENV=production
# Only needed if a browser calls the API from a different origin than SITE_ADDRESS.
CORS_ORIGINS=
SIMULATION_REFERENCE_TIME=

# Frontend build arguments (inlined at build time). Leave the API URL empty: the UI then calls
# /api on its own origin, which Caddy routes to the backend.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_STATUS_POLL_MS=15000
